# Copy to .env (gitignored). Real keys never enter this repository.

# Gemini API key — https://aistudio.google.com/apikey
# Development only. Before any REAL journal data touches the API, the Google
# Cloud project must have billing attached (still $0 within free quota) so the
# no-training "Paid Services" data terms apply. See docs/adr/0001-the-five-pillars.md.
GEMINI_API_KEY=

# Supabase (sync + auth) — create a free project (region: Mumbai) at
# https://supabase.com, run supabase/schema.sql in its SQL editor, then copy
# Project Settings → API values here. Absent values = app runs fully local.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
